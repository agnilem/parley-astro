---
import FormButton from '../FormButton.astro';

/** The Framer original posts to Framer's own form handler. This build posts
 *  to the template's demo relay, which answers the sender to say the form is
 *  not connected yet. A buyer points PUBLIC_FORM_ENDPOINT at their own
 *  endpoint, or empties it to keep submissions local. */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT
  ?? 'https://startfrom-gate.vercel.app/api/form-relay/parley';
const fields = [
  { id: 'first-name', label: 'First name', type: 'text', placeholder: 'Sarah', autocomplete: 'given-name' },
  { id: 'work-email', label: 'Work email', type: 'email', placeholder: 'sarah@company.com', autocomplete: 'email' },
  { id: 'company', label: 'Company', type: 'text', placeholder: 'Notion Labs', autocomplete: 'organization' },
];
---
<div class="cform">
  <img class="cform__bg" src="/assets/contact-clouds.png" alt="" loading="lazy" />
  <form
    class="cform__panel"
    method="post"
    action="#"
    data-demo-form
    data-endpoint={endpoint || undefined}
    data-success-url="/thank-you"
  >
    {fields.map((f) => (
      <div class="cform__field">
        <label class="cform__label" for={f.id}>{f.label}</label>
        <input class="cform__input" id={f.id} name={f.id} type={f.type} placeholder={f.placeholder} autocomplete={f.autocomplete} />
      </div>
    ))}
    <div class="cform__field">
      <label class="cform__label" for="message">Your message</label>
      <textarea class="cform__input cform__input--area" id="message" name="message" rows="4" placeholder="Drop your message"></textarea>
    </div>
    <FormButton label="Send your message" class="cform__submit" />
  </form>
</div>
