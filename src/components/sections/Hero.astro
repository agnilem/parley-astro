---
import Button from '../Button.astro';
// Narrower copies of the hero painting for small screens (hero-800.webp ...). The image is stretched to a tall
// box below 1200px, so every copy keeps the full 1200px height and only the width is reduced.
const heroSet = '/assets/hero-800.webp 800w, /assets/hero-1100.webp 1100w, /assets/hero-1600.webp 1600w, /assets/hero.webp 2326w';
---
<section class="hero" id="hero">
  <div class="hero__panel" id="hero-media">
    <img class="hero__img" src="/assets/hero.webp" srcset={heroSet} sizes="(max-width: 1200px) 148vw, 123vw" alt="" width="2326" height="1200" fetchpriority="high" />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1 class="hero__headline">
        The AI agent that works <em>with you</em>,&nbsp;not just for you
      </h1>
      <p class="hero__lede">
        Parley thinks, plans, and acts alongside you &#8212; handling emails,
        scheduling, research, and complex workflows so you can focus on
        the work only you can do.
      </p>
      <Button href="#pricing" label="Get started free" variant="primary" />
    </div>
  </div>
</section>
